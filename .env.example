DATABASE_URL=postgresql+asyncpg://app:app@localhost:5432/app
REDIS_URL=redis://localhost:6379/0
JWT_SECRET=replace-with-a-long-random-secret
# changing LLM_CONFIG_API_KEY_SECRET makes already saved API keys unreadable
LLM_CONFIG_API_KEY_SECRET=replace-with-another-long-random-secret
# Quality: Thai percentage above this value suggests OCR for new uploads
TEXT_QUALITY_DEFAULT_MAX_THAI_PERCENT=50
# Documents upload/validation limits (20 MiB and 30 seconds by default)
DOCUMENTS_MAX_BYTES=20971520
DOCUMENTS_PARSE_TIMEOUT_SECONDS=30
# Total provider deadline for OCR of one page (both passes: transcribe + structure)
DOCUMENTS_OCR_TIMEOUT_SECONDS=90
# TEST_DATABASE_URL=postgresql+asyncpg://app:app@localhost:5432/app_test  # else testcontainers
